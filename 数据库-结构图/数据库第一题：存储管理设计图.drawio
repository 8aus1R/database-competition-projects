        <mxCell id="01R2PEpAfwUid4ZXp3H7-18" value="一个文件存储多个页，一个页分为多个槽位，每一个槽位存储一条记录。" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
