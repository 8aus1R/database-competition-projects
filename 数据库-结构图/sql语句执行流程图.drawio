<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/28.0.6 Chrome/138.0.7204.100 Electron/37.2.3 Safari/537.36" version="28.0.6">
  <diagram name="第 1 页" id="vql4fi7D5sUUk-WyCfne">
    <mxGraphModel dx="1188" dy="701" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="QdL-yk0aWAaqwdoQ4f5d-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="QdL-yk0aWAaqwdoQ4f5d-2" target="QdL-yk0aWAaqwdoQ4f5d-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QdL-yk0aWAaqwdoQ4f5d-2" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;select * from t1, t2, t3 where t1.id = 2 and t1.id = t2.id and t2.id = t3.id&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="75" y="90" width="640" height="40" as="geometry" />
        </mxCell>
        <mxCell id="QdL-yk0aWAaqwdoQ4f5d-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="QdL-yk0aWAaqwdoQ4f5d-5" target="QdL-yk0aWAaqwdoQ4f5d-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QdL-yk0aWAaqwdoQ4f5d-5" value="筛选出 condition 条件，一共是三个板块：t1.id = 2, t1.id = t2.id, t2.id = t3.id" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="690" height="40" as="geometry" />
        </mxCell>
        <mxCell id="QdL-yk0aWAaqwdoQ4f5d-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="QdL-yk0aWAaqwdoQ4f5d-7" target="QdL-yk0aWAaqwdoQ4f5d-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QdL-yk0aWAaqwdoQ4f5d-7" value="&lt;div&gt;进行嵌套子查询操作，首先先提炼出包含谓词的连接条件：t1.id = t2.id.&lt;/div&gt;&lt;div&gt;(谓词就可以理解为 condition 中右边不是列的情况)&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="70" y="300" width="650" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QdL-yk0aWAaqwdoQ4f5d-9" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;接下来进行嵌套连接操作，先处理第一个 where 条件，放入到 join_scan_&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="670" height="40" as="geometry" />
        </mxCell>
        <mxCell id="QdL-yk0aWAaqwdoQ4f5d-11" value="再对第 2 个条件（t2.id = t3.id）进行构建计划，此时t2表以及" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="95" y="790" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="QdL-yk0aWAaqwdoQ4f5d-13" value="join_scan" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="555" width="80" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QdL-yk0aWAaqwdoQ4f5d-15" value="left（t1）" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="230" y="660" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="QdL-yk0aWAaqwdoQ4f5d-16" value="right（t2）" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="410" y="660" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="QdL-yk0aWAaqwdoQ4f5d-20" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.195;exitY=0.943;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="QdL-yk0aWAaqwdoQ4f5d-13" target="QdL-yk0aWAaqwdoQ4f5d-15">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="325" y="842" as="sourcePoint" />
            <mxPoint x="375" y="792" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QdL-yk0aWAaqwdoQ4f5d-21" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.781;exitY=0.914;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.208;entryY=0.099;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="QdL-yk0aWAaqwdoQ4f5d-13" target="QdL-yk0aWAaqwdoQ4f5d-16">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="442" y="812" as="sourcePoint" />
            <mxPoint x="385" y="867" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QdL-yk0aWAaqwdoQ4f5d-24" value="对于第一条连接的where语句t1.id = t2.id, 我们会先执行一次，此时的join_scan就是k。&lt;br&gt;left就是t1表形成的计划，right就是t2表形成的计划方案，此时左边存在一个谓词条件：t1.id =2, 此时的右表为空&lt;br&gt;此时形成的查询计划如下：&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="485" width="610" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
